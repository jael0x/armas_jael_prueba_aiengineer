# Copy to .env and fill in. Never commit .env.

# Required to talk to Claude. Tests do not need it (they use FakeLLM and the committed
# vector cache). Embeddings run locally with EmbeddingGemma and need no key.
ANTHROPIC_API_KEY=

# Models (defaults shown).
MORPHO_LLM_MODEL=claude-haiku-4-5
MORPHO_EMBEDDING_MODEL=google/embeddinggemma-300m

# Judge for the golden set evaluation (uv run python -m morpho.evals.run_eval).
MORPHO_JUDGE_MODEL=claude-sonnet-5-5

# Optional: Claude effort (low, medium, high, xhigh, max). Leave empty for Claude Haiku 4.5,
# which does not accept it.
MORPHO_EFFORT=

# Optional: where the embedding model is downloaded (about 1.2 GB). Default: ~/.cache/fastembed
MORPHO_MODELS_DIR=
