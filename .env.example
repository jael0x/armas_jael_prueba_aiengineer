# Copy to .env and fill in. Never commit .env.

# Required to talk to the model and to embed new queries.
# Tests do not need it (they use FakeLLM and the committed vector cache).
OPENAI_API_KEY=

# Optional: point the same SDK at Azure OpenAI / Microsoft Foundry (v1 endpoint),
# e.g. https://<resource>.openai.azure.com/openai/v1/
OPENAI_BASE_URL=

# Models (defaults shown).
MORPHO_LLM_MODEL=gpt-6-luna
MORPHO_EMBEDDING_MODEL=text-embedding-3-small
